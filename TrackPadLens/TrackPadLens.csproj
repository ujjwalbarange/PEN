<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>TrackPadLens</AssemblyName>
    <RootNamespace>TrackPadLens</RootNamespace>
    <Version>1.0.0</Version>
    <Product>TrackPadLens</Product>
    <Description>High-performance Windows writing tablet turning a Precision Touchpad into an absolute-positioned writing lens.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishDir>publish\</PublishDir>
    <PublishSingleFile Condition="'$(SelfContained)' == 'true'">true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract Condition="'$(SelfContained)' == 'true'">true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile Condition="'$(SelfContained)' == 'true'">true</EnableCompressionInSingleFile>
    <DebugType Condition="'$(Configuration)' == 'Release'">embedded</DebugType>
  </PropertyGroup>

  <!-- Keep Tests subfolder excluded from main application compilation -->
  <ItemGroup>
    <Compile Remove="Tests\**" />
    <EmbeddedResource Remove="Tests\**" />
    <None Remove="Tests\**" />
    <Page Remove="Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TrackPadLens.Tests" />
  </ItemGroup>

  <!-- Stage runnable Debug/Release executable + PDB symbols to project root ONLY after successful build -->
  <Target Name="CopyExecutableToRoot" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true' And '$(PublishSingleFile)' != 'true' And Exists('$(TargetDir)$(AssemblyName).exe')">
    <ItemGroup>
      <RootStageFiles Include="$(TargetDir)$(AssemblyName).exe" />
      <RootStageFiles Include="$(TargetDir)$(AssemblyName).dll" />
      <RootStageFiles Include="$(TargetDir)$(AssemblyName).deps.json" />
      <RootStageFiles Include="$(TargetDir)$(AssemblyName).runtimeconfig.json" />
      <RootStageFiles Include="$(TargetDir)$(AssemblyName).pdb" Condition="Exists('$(TargetDir)$(AssemblyName).pdb')" />
    </ItemGroup>
    <Copy SourceFiles="@(RootStageFiles)"
          DestinationFolder="$(MSBuildProjectDirectory)\"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
