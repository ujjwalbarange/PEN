<Window x:Class="TrackPadLens.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TrackPadLens — Diagnostics &amp; Hardware Control"
        Width="780"
        Height="640"
        Background="#0B1120"
        Foreground="#E2E8F0"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="TrackPadLens" FontSize="22" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                <TextBlock x:Name="ModeBannerText" FontSize="12" Foreground="#94A3B8" Margin="0,3,0,0" TextWrapping="Wrap" MaxWidth="480"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Open Workspace (Alt+W)" Padding="12,8" Margin="0,0,8,0"
                        Background="#1E293B" Foreground="#00D2FF" BorderBrush="#00D2FF" FontWeight="SemiBold" Click="WorkspaceBtn_Click"/>
                <Button x:Name="ToggleDoodleBtn" Content="Enable Doodle Mode" Padding="14,8" Margin="0,0,8,0"
                        Background="#00D2FF" Foreground="#0B1120" FontWeight="SemiBold" BorderThickness="0" Click="ToggleDoodleBtn_Click"/>
                <Button Content="Refresh Devices" Padding="12,8" Background="#1E293B" Foreground="#E2E8F0" BorderBrush="#334155" Click="RefreshBtn_Click"/>
            </StackPanel>
        </DockPanel>

        <!-- Telemetry & Capability Grid -->
        <Border Grid.Row="1" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,14">
            <UniformGrid Columns="2" Rows="6">
                <StackPanel Margin="0,0,12,8">
                    <TextBlock Text="Touchpad Detection" FontSize="11" Foreground="#64748B"/>
                    <TextBlock x:Name="TouchpadStatusText" FontFamily="Consolas" FontSize="12.5" Foreground="#F1F5F9" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Margin="12,0,0,8">
                    <TextBlock Text="External Mouse Detection" FontSize="11" Foreground="#64748B"/>
                    <TextBlock x:Name="MouseStatusText" FontFamily="Consolas" FontSize="12.5" Foreground="#F1F5F9" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,8">
                    <TextBlock Text="HID Absolute Coordinates" FontSize="11" Foreground="#64748B"/>
                    <TextBlock x:Name="HidCoordText" FontFamily="Consolas" FontSize="12.5" Foreground="#F1F5F9"/>
                </StackPanel>
                <StackPanel Margin="12,0,0,8">
                    <TextBlock Text="Input Report Rate" FontSize="11" Foreground="#64748B"/>
                    <TextBlock x:Name="ReportRateText" FontFamily="Consolas" FontSize="12.5" Foreground="#F1F5F9"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,8">
                    <TextBlock Text="Current Input Mode" FontSize="11" Foreground="#64748B"/>
                    <TextBlock x:Name="InputModeText" FontFamily="Consolas" FontSize="12.5" Foreground="#00D2FF"/>
                </StackPanel>
                <StackPanel Margin="12,0,0,8">
                    <TextBlock Text="Cursor Isolation Capability" FontSize="11" Foreground="#64748B"/>
                    <TextBlock x:Name="CursorIsolationText" FontFamily="Consolas" FontSize="12.5" Foreground="#F1F5F9"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,8">
                    <TextBlock Text="Active Lens Dimensions" FontSize="11" Foreground="#64748B"/>
                    <TextBlock x:Name="LensDimensionsText" FontFamily="Consolas" FontSize="12.5" Foreground="#F1F5F9"/>
                </StackPanel>
                <StackPanel Margin="12,0,0,8">
                    <TextBlock Text="Current Aspect Ratio" FontSize="11" Foreground="#64748B"/>
                    <TextBlock x:Name="AspectRatioText" FontFamily="Consolas" FontSize="12.5" Foreground="#F1F5F9"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,4">
                    <TextBlock Text="1-Euro Smoothing Parameters" FontSize="11" Foreground="#64748B"/>
                    <TextBlock x:Name="SmoothingParamsText" FontFamily="Consolas" FontSize="12.5" Foreground="#F1F5F9"/>
                </StackPanel>
                <StackPanel Margin="12,0,0,4">
                    <TextBlock Text="Rendering FPS / Memory Usage" FontSize="11" Foreground="#64748B"/>
                    <TextBlock x:Name="FpsMemoryText" FontFamily="Consolas" FontSize="12.5" Foreground="#F1F5F9"/>
                </StackPanel>
                <StackPanel Margin="0,4,12,0">
                    <TextBlock Text="Physical Dimensions &amp; Contacts" FontSize="11" Foreground="#64748B"/>
                    <TextBlock x:Name="PhysicalSpecText" FontFamily="Consolas" FontSize="12.5" Foreground="#F1F5F9"/>
                </StackPanel>
                <StackPanel Margin="12,4,0,0">
                    <TextBlock Text="Global Hotkeys" FontSize="11" Foreground="#64748B"/>
                    <TextBlock x:Name="HotkeyStatusText" FontFamily="Consolas" FontSize="12" Foreground="#F1F5F9" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </UniformGrid>
        </Border>

        <!-- Hardware Test Mode (Raw Input Inspector without creating permanent strokes) -->
        <Border Grid.Row="2" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="6" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Hardware Test Mode (Live Raw HID Inspector)" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                        <TextBlock Text="Displays real incoming Precision Touchpad HID reports without drawing permanent ink strokes." FontSize="11.5" Foreground="#94A3B8"/>
                    </StackPanel>
                    <CheckBox x:Name="HardwareTestToggle" DockPanel.Dock="Right" Content="Enable Test Mode" VerticalAlignment="Center"
                              Foreground="#00D2FF" Checked="HardwareTestToggle_Changed" Unchecked="HardwareTestToggle_Changed"/>
                </DockPanel>
                <TextBox x:Name="RawLogBox" Grid.Row="1" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                         Background="#070B14" Foreground="#CBD5E1" BorderBrush="#1E293B"
                         FontFamily="Consolas" FontSize="12" Padding="10" TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <!-- Footer Actions -->
        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Content="Calibration..." Padding="12,7" Margin="0,0,8,0" Background="#1E293B" Foreground="#E2E8F0" BorderBrush="#334155" Click="CalibrationBtn_Click"/>
                <Button Content="Settings..." Padding="12,7" Margin="0,0,8,0" Background="#1E293B" Foreground="#E2E8F0" BorderBrush="#334155" Click="SettingsBtn_Click"/>
                <Button Content="Region Capture (Alt+Shift+S)" Padding="12,7" Margin="0,0,8,0" Background="#1E293B" Foreground="#E2E8F0" BorderBrush="#334155" Click="RegionCaptureBtn_Click"/>
                <Button Content="Save Snapshot (Ctrl+S)" Padding="12,7" Background="#1E293B" Foreground="#E2E8F0" BorderBrush="#334155" Click="SnapshotBtn_Click"/>
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="Hide to System Tray" Padding="12,7" Background="#1E293B" Foreground="#E2E8F0" BorderBrush="#334155" Click="HideToTrayBtn_Click"/>
        </DockPanel>
    </Grid>
</Window>
