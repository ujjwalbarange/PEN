<Window x:Class="TrackPadLens.UI.FloatingToolbar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TrackPadLens Toolbar"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#263348"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#334155"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColorBtn" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
        </Style>
    </Window.Resources>

    <Border x:Name="PillBorder"
            Background="#DD0F172A"
            BorderBrush="#4094A3B8"
            BorderThickness="1"
            CornerRadius="22"
            Padding="8,5">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- Drag Handle -->
            <Border x:Name="DragGrip"
                    Width="16"
                    Height="28"
                    Background="Transparent"
                    Cursor="SizeAll"
                    ToolTip="Drag toolbar"
                    MouseLeftButtonDown="DragGrip_MouseLeftButtonDown">
                <TextBlock Text="⋮⋮" Foreground="#64748B" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- 1. Doodle Mode ON/OFF -->
            <Button x:Name="DoodleToggleBtn" Style="{StaticResource ToolBtn}" ToolTip="Toggle Doodle Mode (Alt+D)" Click="DoodleToggleBtn_Click">
                <Ellipse x:Name="DoodleDot" Width="12" Height="12" Fill="#64748B" Stroke="#E2E8F0" StrokeThickness="1.2"/>
            </Button>

            <StackPanel x:Name="ExpandedControls" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="1" Height="18" Background="#334155" Margin="5,0"/>

                <!-- 2. Pen Colors: Red, Blue, Yellow Highlighter (40%), White, Black -->
                <Button x:Name="ColorRedBtn" Style="{StaticResource ColorBtn}" ToolTip="Red Pen (#FF3B30) — Press D to select/cycle pen" Click="ColorRedBtn_Click">
                    <Ellipse Width="14" Height="14" Fill="#FF3B30"/>
                </Button>
                <Button x:Name="ColorBlueBtn" Style="{StaticResource ColorBtn}" ToolTip="Blue Pen (#007AFF) — Press D to select/cycle pen" Click="ColorBlueBtn_Click">
                    <Ellipse Width="14" Height="14" Fill="#007AFF"/>
                </Button>
                <Button x:Name="ColorHighlighterBtn" Style="{StaticResource ColorBtn}" ToolTip="Yellow Highlighter (#FFCC00 40%)" Click="ColorHighlighterBtn_Click">
                    <Ellipse Width="14" Height="14" Fill="#FFCC00" Opacity="0.7" Stroke="#FFCC00" StrokeThickness="1"/>
                </Button>
                <Button x:Name="ColorWhiteBtn" Style="{StaticResource ColorBtn}" ToolTip="White Pen — Press D to select/cycle pen" Click="ColorWhiteBtn_Click">
                    <Ellipse Width="14" Height="14" Fill="#FFFFFF" Stroke="#475569" StrokeThickness="1"/>
                </Button>
                <Button x:Name="ColorBlackBtn" Style="{StaticResource ColorBtn}" ToolTip="Black Pen — Press D to select/cycle pen" Click="ColorBlackBtn_Click">
                    <Ellipse Width="14" Height="14" Fill="#000000" Stroke="#94A3B8" StrokeThickness="1"/>
                </Button>

                <Border Width="1" Height="18" Background="#334155" Margin="5,0"/>

                <!-- 3. Stroke Thickness (1 / 2 / 3 in Doodle Mode) -->
                <Button x:Name="ThickThinBtn" Style="{StaticResource ColorBtn}" ToolTip="Thin Stroke (2px) [1]" Click="ThickThinBtn_Click">
                    <Ellipse Width="4" Height="4" Fill="#E2E8F0"/>
                </Button>
                <Button x:Name="ThickMedBtn" Style="{StaticResource ColorBtn}" ToolTip="Medium Stroke (4px) [2]" Click="ThickMedBtn_Click">
                    <Ellipse Width="8" Height="8" Fill="#E2E8F0"/>
                </Button>
                <Button x:Name="ThickHeavyBtn" Style="{StaticResource ColorBtn}" ToolTip="Thick Stroke (7px) [3]" Click="ThickHeavyBtn_Click">
                    <Ellipse Width="12" Height="12" Fill="#E2E8F0"/>
                </Button>

                <Border Width="1" Height="18" Background="#334155" Margin="5,0"/>

                <!-- 4. Stroke Eraser (E in Doodle Mode) -->
                <Button x:Name="EraserBtn" Style="{StaticResource ToolBtn}" ToolTip="Stroke Eraser — erases whole line on contact [E]" Click="EraserBtn_Click">
                    <Canvas Width="16" Height="16">
                        <Path Data="M 3,11 L 9,4 L 14,9 L 10,13 L 5,13 Z" Stroke="#F8FAFC" StrokeThickness="1.4" Fill="#334155" StrokeLineJoin="Round"/>
                        <Line X1="7" Y1="6.5" X2="11.5" Y2="11" Stroke="#F8FAFC" StrokeThickness="1.2"/>
                    </Canvas>
                </Button>

                <!-- 5. Laser Mode -->
                <Button x:Name="LaserBtn" Style="{StaticResource ToolBtn}" ToolTip="Laser Pointer (1.5s fade)" Click="LaserBtn_Click">
                    <TextBlock Text="✦" FontSize="14" Foreground="#FF453A"/>
                </Button>

                <!-- 6. Undo -->
                <Button Style="{StaticResource ToolBtn}" ToolTip="Undo Last Action (Ctrl+Z)" Click="UndoBtn_Click">
                    <TextBlock Text="↶" FontSize="15"/>
                </Button>

                <!-- 7. Clear -->
                <Button Style="{StaticResource ToolBtn}" ToolTip="Clear All Ink [C in Doodle Mode]" Click="ClearBtn_Click">
                    <TextBlock Text="✕" FontSize="13"/>
                </Button>

                <!-- 8. Save Snapshot -->
                <Button Style="{StaticResource ToolBtn}" ToolTip="Save Snapshot (Ctrl+S)" Click="SnapshotBtn_Click">
                    <TextBlock Text="⬒" FontSize="14"/>
                </Button>

                <Border Width="1" Height="18" Background="#334155" Margin="5,0"/>

                <!-- 9. Lens Size Lock / Unlock (stops mouse wheel from resizing Lens) -->
                <Button x:Name="SizeLockBtn" Style="{StaticResource ToolBtn}" ToolTip="Lock Lens Size (prevent mouse wheel resize)" Click="SizeLockBtn_Click">
                    <Canvas Width="16" Height="16">
                        <!-- Locked padlock shackle -->
                        <Path x:Name="LockClosedShackle" Data="M 5,7 V 5 A 3,3 0 0 1 11,5 V 7" Stroke="#00D2FF" StrokeThickness="1.5" Visibility="Collapsed"/>
                        <!-- Unlocked padlock shackle -->
                        <Path x:Name="LockOpenShackle" Data="M 5,7 V 5 A 3,3 0 0 1 11,4.2" Stroke="#94A3B8" StrokeThickness="1.5" Visibility="Visible"/>
                        <!-- Padlock body -->
                        <Rectangle x:Name="LockBody" Canvas.Left="3.5" Canvas.Top="7" Width="9" Height="6.8" RadiusX="1.6" RadiusY="1.6" Stroke="#94A3B8" StrokeThickness="1.4" Fill="Transparent"/>
                    </Canvas>
                </Button>

                <!-- 10. Calibration -->
                <Button Style="{StaticResource ToolBtn}" ToolTip="Touchpad Calibration" Click="CalibrationBtn_Click">
                    <TextBlock Text="⊞" FontSize="14"/>
                </Button>

                <!-- 11. Settings -->
                <Button Style="{StaticResource ToolBtn}" ToolTip="Settings &amp; Lens Appearance" Click="SettingsBtn_Click">
                    <TextBlock Text="⚙" FontSize="14"/>
                </Button>

                <!-- 12. Minimize to Tray -->
                <Button Style="{StaticResource ToolBtn}" ToolTip="Minimize to System Tray" Click="TrayBtn_Click">
                    <TextBlock Text="▁" FontSize="12"/>
                </Button>
            </StackPanel>

            <!-- Compact Mode Toggle -->
            <Button x:Name="CompactBtn" Style="{StaticResource ColorBtn}" ToolTip="Compact Mode (keep drawing active)" Click="CompactBtn_Click">
                <TextBlock x:Name="CompactGlyph" Text="‹" FontSize="14" Foreground="#94A3B8"/>
            </Button>
        </StackPanel>
    </Border>
</Window>
