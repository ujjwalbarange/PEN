<Window x:Class="TrackPadLens.UI.WorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:TrackPadLens.UI"
        Title="TrackPadLens — Whiteboard &amp; Smart Study Workspace"
        Width="1360"
        Height="860"
        MinWidth="960"
        MinHeight="620"
        AllowDrop="True"
        WindowStartupLocation="CenterScreen"
        Background="#0B1120"
        Foreground="#E2E8F0"
        PreviewKeyDown="Window_PreviewKeyDown"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <Window.Resources>
        <Style x:Key="SideNavBtn" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E293B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TopToolBtn" TargetType="Button">
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E293B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MagicActionBtn" TargetType="Button" BasedOn="{StaticResource TopToolBtn}">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>

        <Style x:Key="HomeCardBtn" TargetType="Button">
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#1F2937"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Width" Value="210"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#00D2FF"/>
                                <Setter TargetName="Bd" Property="Background" Value="#172033"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="236"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT NAVIGATION & NOTEBOOKS SIDEBAR -->
        <Border x:Name="SidebarPanel" Grid.Column="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,1,0" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <DockPanel Grid.Row="0" Margin="2,2,2,12">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="TrackPadLens" FontSize="16" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                        <TextBlock Text="Whiteboard &amp; Smart Study" FontSize="11" Foreground="#64748B"/>
                    </StackPanel>
                    <Button DockPanel.Dock="Right" x:Name="ThemeToggleBtn" Content="◐" Width="28" Height="28"
                            ToolTip="Toggle Dark / Light Theme" Style="{StaticResource TopToolBtn}" Click="ThemeToggleBtn_Click"/>
                </DockPanel>

                <!-- Primary Navigation -->
                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                    <Button x:Name="NavHomeBtn" Content="⌂  Home" Style="{StaticResource SideNavBtn}" Click="NavHomeBtn_Click"/>
                    <Button x:Name="NavWhiteboardBtn" Content="✎  Whiteboard Canvas" Style="{StaticResource SideNavBtn}" Click="NavWhiteboardBtn_Click"/>
                    <Button x:Name="NavStudyBtn" Content="▤  Smart Study Split" Style="{StaticResource SideNavBtn}" Click="NavStudyBtn_Click"/>
                </StackPanel>

                <!-- Search across notebooks/pages/objects -->
                <Border Grid.Row="2" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,0,12">
                    <DockPanel>
                        <TextBlock Text="⌕" Foreground="#64748B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Foreground="#F8FAFC"
                                 CaretBrush="#00D2FF" FontSize="12" ToolTip="Search notebooks, pages, text, equations (Ctrl+F)"
                                 TextChanged="SearchBox_TextChanged"/>
                    </DockPanel>
                </Border>

                <!-- Notebooks & Pages -->
                <Grid Grid.Row="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="120"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="2,0,2,4">
                        <TextBlock Text="NOTEBOOKS" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" Content="+ New" FontSize="11" Padding="6,2" Style="{StaticResource TopToolBtn}" Click="NewNotebookBtn_Click"/>
                    </DockPanel>

                    <ListBox x:Name="NotebooksList" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="#E2E8F0"
                             Margin="0,0,0,10" SelectionChanged="NotebooksList_SelectionChanged"/>

                    <DockPanel Grid.Row="2" Margin="2,0,2,4">
                        <TextBlock Text="PAGES" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="★" FontSize="11" Padding="5,2" ToolTip="Bookmark Active Page" Style="{StaticResource TopToolBtn}" Click="ToggleBookmarkBtn_Click"/>
                            <Button Content="+ Page" FontSize="11" Padding="6,2" ToolTip="New Page (Ctrl+N)" Style="{StaticResource TopToolBtn}" Click="NewPageBtn_Click"/>
                        </StackPanel>
                    </DockPanel>

                    <ListBox x:Name="PagesList" Grid.Row="3" Background="Transparent" BorderThickness="0" Foreground="#E2E8F0"
                             SelectionChanged="PagesList_SelectionChanged"/>
                </Grid>

                <!-- Sidebar Footer -->
                <StackPanel Grid.Row="4" Margin="0,10,0,0">
                    <Border Height="1" Background="#1E293B" Margin="0,0,0,8"/>
                    <Button Content="◎  Trackpad Lens (Alt+D)" Style="{StaticResource SideNavBtn}" Click="SwitchToLensBtn_Click"/>
                    <Button Content="⬒  Region Capture (Alt+Shift+S)" Style="{StaticResource SideNavBtn}" Click="RegionCaptureBtn_Click"/>
                    <Button Content="⚙  Settings" Style="{StaticResource SideNavBtn}" Click="SettingsBtn_Click"/>
                    <Button Content="◈  Hardware Diagnostics" Style="{StaticResource SideNavBtn}" Click="DiagnosticsBtn_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN WORKSPACE CONTENT AREA -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- TOP COMPACT TOOLBAR (Hidden on Home view or when toggled with Tab) -->
            <Border x:Name="TopToolbarPanel" Grid.Row="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="10,7">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Selection & Drawing Tools -->
                    <Button x:Name="ToolSelectBtn" Content="Select" ToolTip="Smart Selection (V)" Style="{StaticResource TopToolBtn}" Click="ToolSelectBtn_Click"/>
                    <Button x:Name="ToolLassoBtn" Content="Lasso" ToolTip="Freeform Lasso Selection (L)" Style="{StaticResource TopToolBtn}" Click="ToolLassoBtn_Click"/>
                    <Button x:Name="ToolPenBtn" Content="Pen" ToolTip="Pen (P)" Style="{StaticResource TopToolBtn}" Click="ToolPenBtn_Click"/>
                    <Button x:Name="ToolPencilBtn" Content="Pencil" ToolTip="Pencil" Style="{StaticResource TopToolBtn}" Click="ToolPencilBtn_Click"/>
                    <Button x:Name="ToolMarkerBtn" Content="Marker" ToolTip="Marker" Style="{StaticResource TopToolBtn}" Click="ToolMarkerBtn_Click"/>
                    <Button x:Name="ToolHighlighterBtn" Content="Highlight" ToolTip="Highlighter (H)" Style="{StaticResource TopToolBtn}" Click="ToolHighlighterBtn_Click"/>
                    <Button x:Name="ToolEraserBtn" Content="Eraser" ToolTip="Stroke Eraser (E)" Style="{StaticResource TopToolBtn}" Click="ToolEraserBtn_Click"/>

                    <Border Width="1" Height="18" Background="#334155" Margin="6,0"/>

                    <!-- Shapes, Connectors, Objects -->
                    <Button x:Name="ToolShapeBtn" Content="Shape" ToolTip="Draw Vector Shape" Style="{StaticResource TopToolBtn}" Click="ToolShapeBtn_Click"/>
                    <ComboBox x:Name="ShapeKindCombo" Width="92" Margin="2,0,4,0" VerticalAlignment="Center" SelectedIndex="0"
                              SelectionChanged="ShapeKindCombo_SelectionChanged">
                        <ComboBoxItem Content="Rectangle"/>
                        <ComboBoxItem Content="Ellipse"/>
                        <ComboBoxItem Content="Triangle"/>
                        <ComboBoxItem Content="Diamond"/>
                        <ComboBoxItem Content="Line"/>
                        <ComboBoxItem Content="Arrow"/>
                    </ComboBox>
                    <Button x:Name="ToolConnectorBtn" Content="Arrow" ToolTip="Connector Arrow" Style="{StaticResource TopToolBtn}" Click="ToolConnectorBtn_Click"/>
                    <Button x:Name="ToolTextBtn" Content="Text" ToolTip="Insert Text Box" Style="{StaticResource TopToolBtn}" Click="ToolTextBtn_Click"/>
                    <Button x:Name="ToolEquationBtn" Content="∑ Math" ToolTip="Insert / Solve Equation" Style="{StaticResource TopToolBtn}" Click="ToolEquationBtn_Click"/>
                    <Button x:Name="ToolStickyBtn" Content="Sticky" ToolTip="Insert Sticky Note" Style="{StaticResource TopToolBtn}" Click="ToolStickyBtn_Click"/>
                    <Button Content="+ Image" ToolTip="Insert Image from Disk" Style="{StaticResource TopToolBtn}" Click="InsertImageBtn_Click"/>

                    <Border Width="1" Height="18" Background="#334155" Margin="6,0"/>

                    <!-- Color Swatches -->
                    <Button Width="20" Height="20" Margin="2,0" Background="#FF3B30" BorderBrush="#64748B" Tag="#FF3B30" ToolTip="Red" Click="ColorSwatch_Click"/>
                    <Button Width="20" Height="20" Margin="2,0" Background="#007AFF" BorderBrush="#64748B" Tag="#007AFF" ToolTip="Blue" Click="ColorSwatch_Click"/>
                    <Button Width="20" Height="20" Margin="2,0" Background="#10B981" BorderBrush="#64748B" Tag="#10B981" ToolTip="Green" Click="ColorSwatch_Click"/>
                    <Button Width="20" Height="20" Margin="2,0" Background="#F59E0B" BorderBrush="#64748B" Tag="#F59E0B" ToolTip="Amber" Click="ColorSwatch_Click"/>
                    <Button Width="20" Height="20" Margin="2,0" Background="#F8FAFC" BorderBrush="#64748B" Tag="#F8FAFC" ToolTip="White" Click="ColorSwatch_Click"/>
                    <Button Width="20" Height="20" Margin="2,0" Background="#0F172A" BorderBrush="#94A3B8" Tag="#0F172A" ToolTip="Black" Click="ColorSwatch_Click"/>

                    <!-- Thickness -->
                    <ComboBox x:Name="ThicknessCombo" Width="76" Margin="6,0,2,0" VerticalAlignment="Center" SelectedIndex="1"
                              SelectionChanged="ThicknessCombo_SelectionChanged">
                        <ComboBoxItem Content="Thin"/>
                        <ComboBoxItem Content="Medium"/>
                        <ComboBoxItem Content="Thick"/>
                    </ComboBox>

                    <Border Width="1" Height="18" Background="#334155" Margin="6,0"/>

                    <!-- Undo / Redo / Zoom -->
                    <Button Content="↶" ToolTip="Undo (Ctrl+Z)" Style="{StaticResource TopToolBtn}" Click="UndoBtn_Click"/>
                    <Button Content="↷" ToolTip="Redo (Ctrl+Y)" Style="{StaticResource TopToolBtn}" Click="RedoBtn_Click"/>
                    <Button Content="−" ToolTip="Zoom Out (Ctrl+-)" Style="{StaticResource TopToolBtn}" Click="ZoomOutBtn_Click"/>
                    <TextBlock x:Name="ZoomLabel" Text="100%" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" Margin="4,0"/>
                    <Button Content="+" ToolTip="Zoom In (Ctrl++)" Style="{StaticResource TopToolBtn}" Click="ZoomInBtn_Click"/>
                    <Button Content="Fit" ToolTip="Fit Canvas (Ctrl+0)" Style="{StaticResource TopToolBtn}" Click="FitCanvasBtn_Click"/>

                    <Border Width="1" Height="18" Background="#334155" Margin="6,0"/>

                    <!-- Paper Style & Layout -->
                    <ComboBox x:Name="PaperStyleCombo" Width="82" Margin="2,0" VerticalAlignment="Center" SelectedIndex="2"
                              ToolTip="Canvas Background Pattern" SelectionChanged="PaperStyleCombo_SelectionChanged">
                        <ComboBoxItem Content="Blank"/>
                        <ComboBoxItem Content="Ruled"/>
                        <ComboBoxItem Content="Dotted"/>
                        <ComboBoxItem Content="Grid"/>
                    </ComboBox>
                    <ComboBox x:Name="CanvasModeCombo" Width="84" Margin="2,0" VerticalAlignment="Center" SelectedIndex="0"
                              ToolTip="Infinite Canvas vs Paged Notebook" SelectionChanged="CanvasModeCombo_SelectionChanged">
                        <ComboBoxItem Content="Infinite"/>
                        <ComboBoxItem Content="Paged"/>
                    </ComboBox>
                    <ComboBox x:Name="StudyLayoutCombo" Width="116" Margin="2,0" VerticalAlignment="Center" SelectedIndex="2"
                              ToolTip="Study Workspace Layout" SelectionChanged="StudyLayoutCombo_SelectionChanged">
                        <ComboBoxItem Content="Doc Focus"/>
                        <ComboBoxItem Content="Split Study"/>
                        <ComboBoxItem Content="Free Canvas"/>
                    </ComboBox>

                    <Border Width="1" Height="18" Background="#334155" Margin="6,0"/>

                    <!-- File & Export Actions -->
                    <Button Content="Open Doc" ToolTip="Open PDF, DOCX, Image, or TXT" Style="{StaticResource TopToolBtn}" Click="OpenDocumentBtn_Click"/>
                    <Button Content="Save" ToolTip="Save .tlproject Workspace (Ctrl+S)" Style="{StaticResource TopToolBtn}" Click="SaveProjectBtn_Click"/>
                    <Button Content="Export PNG" Style="{StaticResource TopToolBtn}" Click="ExportPngBtn_Click"/>
                    <Button Content="Export PDF" ToolTip="Export Multi-Page Flattened PDF" Style="{StaticResource TopToolBtn}" Click="ExportPdfBtn_Click"/>
                </WrapPanel>
            </Border>

            <!-- CONTEXTUAL MAGIC MENU (Appears cleanly only when objects are selected or triggered via Ctrl+Space) -->
            <Border x:Name="MagicMenuBar" Grid.Row="1" Visibility="Collapsed"
                    Background="#111C33" BorderBrush="#00D2FF" BorderThickness="0,0,0,1" Padding="12,6">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="MagicSelectionBadge" Text="✦ Magic" Foreground="#00D2FF" FontWeight="SemiBold" FontSize="12" Margin="0,0,10,0" VerticalAlignment="Center"/>

                    <!-- Ink-specific Magic actions -->
                    <StackPanel x:Name="MagicInkActions" Orientation="Horizontal" Visibility="Collapsed">
                        <Button Content="Convert to Text" Style="{StaticResource MagicActionBtn}" Click="MagicConvertToText_Click"/>
                        <Button Content="Clean Handwriting" Style="{StaticResource MagicActionBtn}" Click="MagicCleanHandwriting_Click"/>
                        <Button Content="Typeset" Style="{StaticResource MagicActionBtn}" Click="MagicTypeset_Click"/>
                        <Button Content="Solve Equation" Style="{StaticResource MagicActionBtn}" Click="MagicSolveInkEquation_Click"/>
                    </StackPanel>

                    <!-- Equation-specific Magic actions -->
                    <StackPanel x:Name="MagicEquationActions" Orientation="Horizontal" Visibility="Collapsed">
                        <Button Content="Verify &amp; Solve Equation" Style="{StaticResource MagicActionBtn}" Click="MagicEditSolveEquation_Click"/>
                    </StackPanel>

                    <!-- Image-specific Magic actions -->
                    <StackPanel x:Name="MagicImageActions" Orientation="Horizontal" Visibility="Collapsed">
                        <Button Content="Extract Text (OCR)" Style="{StaticResource MagicActionBtn}" Click="MagicExtractImageText_Click"/>
                        <ComboBox x:Name="DiagramProfileCombo" Width="118" Margin="0,0,5,0" SelectedIndex="0" ToolTip="Diagram Domain Profile">
                            <ComboBoxItem Content="General"/>
                            <ComboBoxItem Content="Mathematics"/>
                            <ComboBoxItem Content="Physics"/>
                            <ComboBoxItem Content="Electrical"/>
                        </ComboBox>
                        <Button Content="Recreate Diagram" Style="{StaticResource MagicActionBtn}" Click="MagicRecreateDiagram_Click"/>
                        <Button Content="Clean Image" Style="{StaticResource MagicActionBtn}" Click="MagicCleanImage_Click"/>
                        <Button Content="Crop" Style="{StaticResource MagicActionBtn}" Click="MagicCropImage_Click"/>
                        <Button Content="Flip H" Style="{StaticResource MagicActionBtn}" Click="MagicFlipH_Click"/>
                        <Button Content="Flip V" Style="{StaticResource MagicActionBtn}" Click="MagicFlipV_Click"/>
                    </StackPanel>

                    <!-- Universal Object Actions -->
                    <Button Content="Duplicate" Style="{StaticResource MagicActionBtn}" Click="MagicDuplicate_Click"/>
                    <Button Content="Group" Style="{StaticResource MagicActionBtn}" Click="MagicGroup_Click"/>
                    <Button Content="Ungroup" Style="{StaticResource MagicActionBtn}" Click="MagicUngroup_Click"/>
                    <Button Content="Align Left" Style="{StaticResource MagicActionBtn}" Click="MagicAlignLeft_Click"/>
                    <Button Content="Front" Style="{StaticResource MagicActionBtn}" Click="MagicBringForward_Click"/>
                    <Button Content="Back" Style="{StaticResource MagicActionBtn}" Click="MagicSendBackward_Click"/>
                    <Button Content="Lock/Unlock" Style="{StaticResource MagicActionBtn}" Click="MagicToggleLock_Click"/>
                    <Button Content="Delete" Foreground="#FCA5A5" Style="{StaticResource MagicActionBtn}" Click="MagicDelete_Click"/>
                </WrapPanel>
            </Border>

            <!-- HOME DASHBOARD VIEW -->
            <ScrollViewer x:Name="HomeDashboardView" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="32,26">
                <StackPanel MaxWidth="920" HorizontalAlignment="Left">
                    <TextBlock Text="Welcome to TrackPadLens Workspace" FontSize="26" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                    <TextBlock Text="Clean infinite whiteboard, native PDF &amp; DOCX study workspace, and offline intelligent ink tools."
                               FontSize="13.5" Foreground="#94A3B8" Margin="0,4,0,22"/>

                    <TextBlock Text="QUICK ACTIONS" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,10"/>
                    <WrapPanel Margin="0,0,0,20">
                        <Button Style="{StaticResource HomeCardBtn}" Click="HomeNewWhiteboard_Click">
                            <StackPanel>
                                <TextBlock Text="✎  New Whiteboard" FontSize="14" FontWeight="SemiBold" Foreground="#00D2FF"/>
                                <TextBlock Text="Start fresh infinite or paged notes" FontSize="11.5" Foreground="#94A3B8" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource HomeCardBtn}" Click="OpenDocumentBtn_Click">
                            <StackPanel>
                                <TextBlock Text="▤  Open Document" FontSize="14" FontWeight="SemiBold" Foreground="#34D399"/>
                                <TextBlock Text="PDF, DOCX, PNG, JPG, WebP, TXT" FontSize="11.5" Foreground="#94A3B8" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource HomeCardBtn}" Click="OpenProjectBtn_Click">
                            <StackPanel>
                                <TextBlock Text="◫  Open Project" FontSize="14" FontWeight="SemiBold" Foreground="#FBBF24"/>
                                <TextBlock Text="Load saved .tlproject archive" FontSize="11.5" Foreground="#94A3B8" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource HomeCardBtn}" Click="RegionCaptureBtn_Click">
                            <StackPanel>
                                <TextBlock Text="⬒  Region Capture" FontSize="14" FontWeight="SemiBold" Foreground="#A78BFA"/>
                                <TextBlock Text="Snip any screen area into canvas" FontSize="11.5" Foreground="#94A3B8" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Recent Workspaces (.tlproject)" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,0,0,8"/>
                                <ListBox x:Name="RecentProjectsList" MinHeight="120" Background="Transparent" BorderThickness="0"
                                         Foreground="#CBD5E1" MouseDoubleClick="RecentProjectsList_DoubleClick"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Recent Study Documents (PDF / DOCX / Images)" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,0,0,8"/>
                                <ListBox x:Name="RecentDocsList" MinHeight="120" Background="Transparent" BorderThickness="0"
                                         Foreground="#CBD5E1" MouseDoubleClick="RecentDocsList_DoubleClick"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="Tip: Drag and drop any PDF, DOCX, image, TXT, or .tlproject file onto this window at any time, or press Ctrl+V to paste screenshots directly onto the whiteboard."
                               FontSize="12" Foreground="#64748B" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>

            <!-- WHITEBOARD + SMART STUDY SPLIT VIEW -->
            <Grid x:Name="WorkspaceSplitView" Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="DocumentPaneColumn" Width="0"/>
                    <ColumnDefinition x:Name="SplitterColumn" Width="0"/>
                    <ColumnDefinition x:Name="CanvasPaneColumn" Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- DOCUMENT REFERENCE PANEL (PDF / DOCX) -->
                <Border x:Name="DocumentPaneBorder" Grid.Column="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,1,0" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Document Header Controls -->
                        <Border Grid.Row="0" Background="#111827" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="10,8">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left" MaxWidth="260">
                                    <TextBlock x:Name="DocTitleText" Text="No Document Loaded" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="DocNoticeText" Text="" FontSize="10.5" Foreground="#94A3B8" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="◀" ToolTip="Previous Page" Style="{StaticResource TopToolBtn}" Click="DocPrevPage_Click"/>
                                    <TextBlock x:Name="DocPageCounterText" Text="0 / 0" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" Margin="4,0"/>
                                    <Button Content="▶" ToolTip="Next Page" Style="{StaticResource TopToolBtn}" Click="DocNextPage_Click"/>
                                    <Button Content="↻" ToolTip="Rotate Page 90°" Style="{StaticResource TopToolBtn}" Click="DocRotatePage_Click"/>
                                    <Button Content="Send to Whiteboard →" Background="#00D2FF" Foreground="#0B1120" FontWeight="SemiBold"
                                            Style="{StaticResource TopToolBtn}" Margin="6,0,0,0" Click="SendDocPageToWhiteboard_Click"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Optional Annotate-in-Place toggle for PDF pages -->
                        <Border Grid.Row="1" Background="#0B1324" Padding="10,4" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
                            <DockPanel>
                                <TextBlock Text="Original document is opened read-only (annotations saved non-destructively)." FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                <Button DockPanel.Dock="Right" Content="Annotate Page Directly" FontSize="11" Style="{StaticResource TopToolBtn}" Click="AnnotateDocPageDirectly_Click"/>
                            </DockPanel>
                        </Border>

                        <!-- PDF Page Render Viewer -->
                        <ScrollViewer x:Name="PdfScrollViewer" Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="14">
                            <Image x:Name="PdfPageImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                        </ScrollViewer>

                        <!-- Native DOCX Structured Viewer (fallback when LibreOffice is absent) -->
                        <ScrollViewer x:Name="DocxFallbackViewer" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="18">
                            <StackPanel x:Name="DocxBlocksStack"/>
                        </ScrollViewer>

                        <!-- PDF Page Thumbnail Strip -->
                        <ScrollViewer x:Name="PdfThumbStripScroller" Grid.Row="3" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                      Height="76" Background="#0B1120" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="8,6">
                            <StackPanel x:Name="PdfThumbStrip" Orientation="Horizontal"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <GridSplitter x:Name="StudySplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#1E293B" Visibility="Collapsed"/>

                <!-- MAIN WHITEBOARD / ANNOTATION CANVAS -->
                <Grid Grid.Column="2">
                    <ui:WorkspaceCanvasControl x:Name="CanvasHost"/>
                </Grid>
            </Grid>

            <!-- BOTTOM STATUS BAR -->
            <Border x:Name="StatusBarPanel" Grid.Row="3" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="12,5">
                <DockPanel>
                    <TextBlock x:Name="StatusLeftText" DockPanel.Dock="Left" Text="Ready — Whiteboard Canvas" FontSize="11.5" Foreground="#94A3B8"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock x:Name="AutosaveStatusText" Text="Autosave armed" FontSize="11" Foreground="#64748B" Margin="0,0,14,0"/>
                        <TextBlock x:Name="ObjectCountText" Text="0 objects" FontSize="11" FontFamily="Consolas" Foreground="#64748B"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
