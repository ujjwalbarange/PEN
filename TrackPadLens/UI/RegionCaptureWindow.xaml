<Window x:Class="TrackPadLens.UI.RegionCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TrackPadLens Region Capture"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Cursor="Cross"
        Background="Black"
        KeyDown="Window_KeyDown"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseMove="Window_MouseMove"
        MouseLeftButtonUp="Window_MouseLeftButtonUp">
    <Grid>
        <Image x:Name="DesktopSnapshotImage" Stretch="Fill" SnapsToDevicePixels="True"/>
        <Canvas x:Name="SelectionCanvas" Background="#55000000">
            <Border x:Name="SelectionRect"
                    Visibility="Collapsed"
                    BorderBrush="#00D2FF"
                    BorderThickness="2"
                    Background="#1800D2FF"/>
            <Border x:Name="DimensionsBadge"
                    Visibility="Collapsed"
                    Background="#DD0F172A"
                    BorderBrush="#00D2FF"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="8,4">
                <TextBlock x:Name="DimensionsText" Foreground="#F8FAFC" FontFamily="Consolas" FontSize="12"/>
            </Border>
        </Canvas>
        <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0"
                Background="#E00F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="18" Padding="16,8">
            <TextBlock Text="Drag to capture a screen region into TrackPadLens  ·  Press Enter for full screen  ·  Press Esc to cancel"
                       Foreground="#E2E8F0" FontSize="12.5"/>
        </Border>
    </Grid>
</Window>
