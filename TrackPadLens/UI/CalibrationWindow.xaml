<Window x:Class="TrackPadLens.UI.CalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TrackPadLens — Touchpad Calibration"
        Width="520"
        Height="510"
        Background="#0F172A"
        Foreground="#E2E8F0"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Touchpad Active Area &amp; Aspect Ratio" FontSize="18" FontWeight="SemiBold" Foreground="#F8FAFC"/>
            <TextBlock x:Name="HardwareSummaryText" Margin="0,4,0,0" FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" Height="150" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Margin="0,0,0,14">
            <Canvas x:Name="PreviewCanvas" Width="360" Height="130" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Rectangle Width="360" Height="130" Stroke="#475569" StrokeThickness="1" Fill="#0B1220"/>
                <Rectangle x:Name="ActiveRegionRect" Stroke="#00D2FF" StrokeThickness="1.5" Fill="#1A00D2FF"/>
            </Canvas>
        </Border>

        <StackPanel Grid.Row="2" VerticalAlignment="Top">
            <CheckBox x:Name="UsePhysicalAspectCheck" Content="Use hardware physical aspect ratio when available" Foreground="#E2E8F0" Margin="0,0,0,10" Checked="OnFieldChanged" Unchecked="OnFieldChanged"/>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="56"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Manual Aspect Ratio (W/H)" VerticalAlignment="Center" Foreground="#CBD5E1"/>
                <Slider x:Name="AspectSlider" Grid.Column="1" Minimum="0.8" Maximum="2.6" Value="1.6" TickFrequency="0.05" ValueChanged="OnSliderChanged"/>
                <TextBlock x:Name="AspectValueText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas" Text="1.60"/>
            </Grid>

            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="56"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Left / Right Margins" VerticalAlignment="Center" Foreground="#CBD5E1"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Slider x:Name="LeftMarginSlider" Width="120" Minimum="0" Maximum="0.35" Value="0" ValueChanged="OnSliderChanged"/>
                    <Slider x:Name="RightMarginSlider" Width="120" Minimum="0.65" Maximum="1.0" Value="1.0" Margin="8,0,0,0" ValueChanged="OnSliderChanged"/>
                </StackPanel>
                <TextBlock x:Name="HorizontalSpanText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas" Text="100%"/>
            </Grid>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="56"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Top / Bottom Margins" VerticalAlignment="Center" Foreground="#CBD5E1"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Slider x:Name="TopMarginSlider" Width="120" Minimum="0" Maximum="0.35" Value="0" ValueChanged="OnSliderChanged"/>
                    <Slider x:Name="BottomMarginSlider" Width="120" Minimum="0.65" Maximum="1.0" Value="1.0" Margin="8,0,0,0" ValueChanged="OnSliderChanged"/>
                </StackPanel>
                <TextBlock x:Name="VerticalSpanText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas" Text="100%"/>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <CheckBox x:Name="InvertXCheck" Content="Invert X Axis" Foreground="#E2E8F0" Margin="0,0,24,0" Checked="OnFieldChanged" Unchecked="OnFieldChanged"/>
                <CheckBox x:Name="InvertYCheck" Content="Invert Y Axis" Foreground="#E2E8F0" Checked="OnFieldChanged" Unchecked="OnFieldChanged"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Reset Defaults" Padding="14,7" Margin="0,0,8,0" Background="#1E293B" Foreground="#E2E8F0" BorderBrush="#334155" Click="ResetBtn_Click"/>
            <Button Content="Cancel" Padding="14,7" Margin="0,0,8,0" Background="#1E293B" Foreground="#E2E8F0" BorderBrush="#334155" Click="CancelBtn_Click"/>
            <Button Content="Apply Calibration" Padding="16,7" Background="#00D2FF" Foreground="#0B1220" FontWeight="SemiBold" BorderThickness="0" Click="ApplyBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>
