<Window x:Class="TrackPadLens.UI.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rendering="clr-namespace:TrackPadLens.Rendering"
        Title="TrackPadLens Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Focusable="False"
        IsHitTestVisible="False">
    <Grid x:Name="RootGrid" Background="Transparent" IsHitTestVisible="False">
        <rendering:InkRenderer x:Name="InkSurface" />
        <rendering:LaserTrailRenderer x:Name="LaserSurface" />
        <Canvas x:Name="LensCanvas" IsHitTestVisible="False" Background="Transparent" />
    </Grid>
</Window>
